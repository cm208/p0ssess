{
  "statusLine": {
    "type": "command",
    "command": "\"$HOME/.config/p0ssess/bin/p0ssess-engine\" statusline"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.config/p0ssess/bin/p0ssess-engine\" hook",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__p0ssess-engine__recommend",
      "mcp__p0ssess-engine__budget_status",
      "mcp__p0ssess-engine__rules_list",
      "mcp__p0ssess-engine__approvals_list",
      "mcp__p0ssess-engine__tendencies",
      "mcp__p0ssess-engine__history_record_outcome"
    ]
  }
}
