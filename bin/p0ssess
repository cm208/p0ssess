#!/bin/sh
# p0ssess launcher. Claude Code runs this from the plugin; it starts the p0ssess binary for this
# platform, which it finds, fetches or builds on first use:
#   1. $P0SSESS_BIN, if set (development)
#   2. dist/p0ssess-<os>-<arch> in the plugin (release archives ship these)
#   3. the cached copy under ~/.cache/p0ssess/bin/<version>/
#   4. a release download, checked against dist/SHA256SUMS (only when dist/release-url exists)
#   5. a local build with Go (the source is the plugin; dependencies are vendored, so no network)
set -eu

version=0.4.0
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)

if [ -n "${P0SSESS_BIN:-}" ]; then exec "$P0SSESS_BIN" "$@"; fi

os=$(uname -s | tr '[:upper:]' '[:lower:]')
case $(uname -m) in
  x86_64 | amd64) arch=amd64 ;;
  aarch64 | arm64) arch=arm64 ;;
  *) arch=$(uname -m) ;;
esac
name=p0ssess-$os-$arch

if [ -x "$root/dist/$name" ]; then exec "$root/dist/$name" "$@"; fi

if [ -n "${P0SSESS_HOME:-}" ]; then cache=$P0SSESS_HOME/cache; else cache=${XDG_CACHE_HOME:-$HOME/.cache}/p0ssess; fi
bin=$cache/bin/$version/$name

ensure() {
  mkdir -p "$cache/bin/$version"
  lock=$bin.lock
  n=0
  until mkdir "$lock" 2>/dev/null; do
    n=$((n + 1))
    if [ "$n" -gt 600 ]; then rm -rf "$lock"; continue; fi
    sleep 0.5
    if [ -x "$bin" ]; then return 0; fi
  done
  trap 'rm -rf "$lock"' EXIT INT TERM
  fetch_or_build
  status=$?
  rm -rf "$lock"
  trap - EXIT INT TERM
  [ "$status" -eq 0 ] || exit 1
}

fetch_or_build() {
  [ -x "$bin" ] && return 0
  tmp=$bin.tmp.$$
  if [ -f "$root/dist/release-url" ] && [ -f "$root/dist/SHA256SUMS" ] && command -v curl >/dev/null 2>&1; then
    url=$(head -n 1 "$root/dist/release-url")
    want=$(awk -v n="$name" '$2 == n { print $1 }' "$root/dist/SHA256SUMS")
    if [ -n "$want" ] && curl -fsSL "$url/v$version/$name" -o "$tmp"; then
      if command -v sha256sum >/dev/null 2>&1; then got=$(sha256sum "$tmp" | awk '{print $1}'); else got=$(shasum -a 256 "$tmp" | awk '{print $1}'); fi
      if [ "$got" = "$want" ]; then chmod 755 "$tmp" && mv "$tmp" "$bin" && return 0; fi
      echo "p0ssess: downloaded $name does not match dist/SHA256SUMS; not using it" >&2
      rm -f "$tmp"
    fi
  fi
  if command -v go >/dev/null 2>&1; then
    echo "p0ssess: building $name $version with $(go version | awk '{print $3}') (first run only)" >&2
    (cd "$root" && CGO_ENABLED=0 go build -trimpath -buildvcs=false \
      -ldflags "-s -w -buildid= -X main.version=$version" -o "$tmp" ./cmd/p0ssess) >&2 &&
      mv "$tmp" "$bin" && return 0
    rm -f "$tmp"
  fi
  echo "p0ssess: no binary for $os/$arch. Install Go 1.27 or later and start a new session, or see docs/INSTALL.md." >&2
  return 1
}

if [ ! -x "$bin" ]; then ensure || exit 1; fi
if [ "${1:-}" = "--ensure" ]; then exit 0; fi
exec "$bin" "$@"
