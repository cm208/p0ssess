{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/p0ssess", "args": ["--ensure"], "timeout": 300 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/p0ssess", "args": ["hook", "prompt"], "timeout": 5 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_p0ssess_p0ssess__(direct|run|wait|abort|answer_permission|recommend|models)",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/p0ssess", "args": ["hook", "tool"], "timeout": 5 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/p0ssess", "args": ["hook", "session-end"], "timeout": 2 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/p0ssess", "args": ["hook", "tool"], "timeout": 5 }
        ]
      }
    ]
  }
}
