{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "p0ssess use-case catalog",
  "type": "object",
  "required": ["version", "as_of", "size_profiles", "use_cases"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "as_of": {"$ref": "#/$defs/date"},
    "size_profiles": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "use_cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/use_case"}
    }
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}"},
    "model_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9.\\-]*(:[a-z]+)?$"},
    "stakes_level": {"type": "integer", "minimum": 1, "maximum": 4},
    "evidence": {
      "type": "object",
      "required": ["source", "as_of"],
      "additionalProperties": false,
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https://"},
        "dataset": {"type": "string", "minLength": 1},
        "as_of": {"$ref": "#/$defs/date"},
        "detail": {"type": "string"}
      },
      "oneOf": [
        {"required": ["url"], "not": {"required": ["dataset"]}},
        {"required": ["dataset"], "not": {"required": ["url"]}}
      ]
    },
    "use_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "id", "origin", "task", "inputs", "outputs", "stakes", "stakes_reason", "quality_bar",
                   "path", "recommended", "alternatives", "est_cost_usd", "cost_assumptions",
                   "budget_sensitivity", "verify", "evidence", "notes"],
      "properties": {
        "n": {"type": "integer", "minimum": 1},
        "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
        "origin": {"enum": ["first-pass", "stakes-review"]},
        "task": {"type": "string", "minLength": 1},
        "inputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "stakes": {"oneOf": [{"$ref": "#/$defs/stakes_level"}, {"const": "inherit"}]},
        "stakes_range": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {"$ref": "#/$defs/stakes_level"}
        },
        "stakes_reason": {"type": "string", "minLength": 1},
        "quality_bar": {"type": "string", "minLength": 1},
        "path": {"enum": ["direct", "agent", "keep_on_claude", "local_tool"]},
        "local_tool": {"type": "string"},
        "engine": {"type": "string"},
        "recommended": {"oneOf": [{"$ref": "#/$defs/model_id"}, {"type": "null"}]},
        "ensemble": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/model_id"}},
        "pipeline": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "alternatives": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/model_id"}},
        "other_options": {"type": "array", "items": {"type": "string"}},
        "est_cost_usd": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["min", "max"],
              "additionalProperties": false,
              "properties": {
                "min": {"type": ["number", "null"], "minimum": 0},
                "max": {"type": ["number", "null"], "minimum": 0}
              }
            }
          ]
        },
        "cost_assumptions": {"type": "string", "minLength": 1},
        "budget_sensitivity": {"enum": ["low", "medium", "high"]},
        "verify": {
          "type": "object",
          "required": ["level", "method"],
          "additionalProperties": false,
          "properties": {
            "level": {"enum": ["none", "spot", "full", "mechanical"]},
            "method": {"type": "string", "minLength": 1}
          }
        },
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "stakes_routing_change": {"type": "string"},
        "related": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "allOf": [
        {
          "if": {"properties": {"recommended": {"type": "null"}}},
          "then": {"anyOf": [
            {"properties": {"path": {"const": "local_tool"}}, "required": ["local_tool"]},
            {"required": ["engine"]}
          ]}
        },
        {
          "if": {"properties": {"path": {"const": "local_tool"}}},
          "then": {"required": ["local_tool"]}
        }
      ]
    }
  }
}
